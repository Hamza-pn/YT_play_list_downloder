# ============================================================================
# youtube-audio-downloader — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Phase 1 default (no server required): sqlite+pysqlite:///./storage/app.db
# Phase 2 production: postgresql+psycopg2://user:password@postgres:5432/ytaudio
DATABASE_URL=sqlite+pysqlite:///./storage/app.db

# --- Cache / Queue (Phase 2+) ---
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false                   # false = in-process asyncio queue (Phase 1)

# --- Storage ---
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# --- FFmpeg / yt-dlp binaries (leave blank to use PATH) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- Limits (guest defaults; premium overrides live in SystemSettings table) ---
MAX_PLAYLIST_VIDEOS=500
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_JOBS_PER_SESSION=1
JOB_TIMEOUT_SECONDS=14400
FILE_RETENTION_HOURS=6
MAX_REQUESTS_PER_MINUTE=10
MAX_DAILY_CONVERSIONS_GUEST=10
MAX_QUALITY_KBPS_GUEST=192

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
